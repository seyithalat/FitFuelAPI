generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model exercises {
  exercise_id       Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  primary_muscle    String?             @db.VarChar(100)
  workout_exercises workout_exercises[]
}

model foods {
  food_id    Int          @id @default(autoincrement())
  name       String       @db.VarChar(100)
  kcal       Int
  carbs      Float        @db.Float
  protein    Float        @db.Float
  fat        Float        @db.Float
  meal_items meal_items[]
}

model meal_items {
  meal_item_id Int   @id @default(autoincrement())
  meal_id      Int
  food_id      Int
  quantity     Float @db.Float
  meals        meals @relation(fields: [meal_id], references: [meal_id], onDelete: Cascade, map: "meal_items_ibfk_1")
  foods        foods @relation(fields: [food_id], references: [food_id], onDelete: Cascade, map: "meal_items_ibfk_2")

  @@index([food_id], map: "food_id")
  @@index([meal_id], map: "meal_id")
}

model meals {
  meal_id    Int          @id @default(autoincrement())
  user_id    Int
  date       DateTime?    @default(now()) @db.DateTime(0)
  meal_items meal_items[]
  users      users        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "meals_ibfk_1")

  @@index([user_id], map: "user_id")
}

model preferences {
  preference_id   Int     @id @default(autoincrement())
  user_id         Int
  liked_exercises String? @db.VarChar(255)
  disliked_foods  String? @db.VarChar(255)
  users           users   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "preferences_ibfk_1")

  @@index([user_id], map: "user_id")
}

model users {
  user_id     Int           @id @default(autoincrement())
  email       String        @unique(map: "email") @db.VarChar(255)
  password    String        @db.VarChar(255)
  is_admin    Boolean       @default(false)
  meals       meals[]
  preferences preferences[]
  workouts    workouts[]
  
}

model workout_exercises {
  workout_exercise_id Int       @id @default(autoincrement())
  workout_id          Int
  exercise_id         Int
  sets                Int
  reps                Int
  weight              Float     @db.Float
  workouts            workouts  @relation(fields: [workout_id], references: [workout_id], onDelete: Cascade, map: "workout_exercises_ibfk_1")
  exercises           exercises @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade, map: "workout_exercises_ibfk_2")

  @@index([exercise_id], map: "exercise_id")
  @@index([workout_id], map: "workout_id")
}

model workouts {
  workout_id        Int                 @id @default(autoincrement())
  user_id           Int
  date              DateTime?           @default(now()) @db.DateTime(0)
  workout_exercises workout_exercises[]
  users             users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "workouts_ibfk_1")

  @@index([user_id], map: "user_id")
}
